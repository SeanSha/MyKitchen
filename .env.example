# Gemini API key from https://aistudio.google.com/apikey
# Used only by server code and scripts. Never prefix it with NEXT_PUBLIC_.
GEMINI_API_KEY=

# Official YouTube video example model as of the video-understanding docs.
# https://ai.google.dev/gemini-api/docs/video-understanding
GEMINI_VIDEO_MODEL=gemini-3.8-flash

# Used only when the primary model id itself is not found.
GEMINI_VIDEO_MODEL_FALLBACK=gemini-3.6-flash
